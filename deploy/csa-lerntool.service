[Unit]
Description=CSA-Lerntool (Node-Server für Oberfläche und Lernstände)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Anpassen: Benutzer und Installationspfad. Der Benutzer braucht Schreibrechte
# nur im Ordner für die Lernstände.
User=csa
Group=csa
WorkingDirectory=/opt/csa-lerntool

# Alle Einstellungen (PORT, HOST, STATE_DIR …) stehen in dieser Datei.
# siehe deploy/env.example – ohne diese Datei startet der Dienst nicht.
EnvironmentFile=/etc/csa-lerntool.env

ExecStart=/usr/bin/node server/index.mjs
Restart=always
RestartSec=5

# Härtung: Schreibzugriff nur auf den Lernstand-Ordner.
# WICHTIG: dieser Ordner muss beim Starten vorhanden sein, sonst bricht systemd
# schon beim Einrichten des Namensraums ab (status=226/NAMESPACE). Er ist im
# Versionsarchiv mit .gitkeep enthalten; von Hand anlegen:
#   install -d -o csa -g csa /opt/csa-lerntool/server-state
# Wird STATE_DIR in /etc/csa-lerntool.env an eine andere Stelle gelegt, muss
# diese Zeile angepasst werden (beide Wege müssen zusammenpassen).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/csa-lerntool/server-state
ProtectKernelTunables=true
RestrictSUIDSGID=true
MemoryMax=256M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=csa-lerntool

[Install]
WantedBy=multi-user.target
