# Kopieren nach .env (wird vom Startskript gelesen) oder als Umgebungsvariablen setzen.
# Werte in Klammern sind die Voreinstellung, wenn die Variable fehlt.

# Port und Adresse, auf denen der Node-Server lauscht (nur intern – nach außen zeigt Caddy).
PORT=8787
HOST=127.0.0.1

# Verzeichnisse: dist/ entsteht durch npm run build, server-state/ enthält die Lernstände.
PUBLIC_DIR=dist
STATE_DIR=server-state

# Caddy liefert X-Forwarded-For – nur dann dürfen die Proxy-Header für die
# Zugriffsbegrenzung benutzt werden.
TRUST_PROXY=1

# Obergrenze für eine Lernstand-Datei in Bytes (Voreinstellung 1500000 = 1,5 MB).
MAX_STATE_BYTES=1500000

# Lernstände automatisch löschen, wenn sie länger nicht benutzt wurden (0 = für immer behalten).
PRUNE_DAYS=0

# Zugriffsbegrenzung je Herkunft-IP.
LIMIT_REGISTER=6
LIMIT_REDEEM=8
LIMIT_WRITE=240

# Jede Anfrage in der Konsole anzeigen (1 = an, sonst aus).
LOG_REQUESTS=0
